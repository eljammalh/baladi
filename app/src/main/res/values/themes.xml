<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Baladi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/baladi_background</item>
        <item name="colorPrimary">@color/baladi_olive</item>
    </style>

    <style name="Theme.Baladi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/baladi_olive</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Baladi</item>
    </style>

</resources>
